# ─────────────────────────────────────────────────────────────
# 덕우전자 AX Web — 환경 변수
#  · Expo 는 EXPO_PUBLIC_ 접두사가 붙은 값만 클라이언트 번들에 주입합니다.
#  · 이 파일을 .env 로 복사한 뒤 값을 채워 사용하세요.
#
#  ★ 보통 .env 를 손댈 필요가 없습니다.
#    어느 서버에 붙는지는 `scripts/targets.cjs` 가 정하고, npm 스크립트가 주입합니다.
#      npm run web          로컬 API (localhost:8080)          VPN 불필요
#      npm run web:server   실서버 API (192.168.2.8:8080)        VPN 필요
#      npm run web:mock     백엔드 없이 목 데이터              VPN 불필요
#      npm run env:check -- list   대상 목록 · 상태 확인
#
#  ★ 사내 배포의 두 포트 — 역할이 다릅니다
#      WEB  http://192.168.2.8:8081   사람이 여는 주소 (start.sh · serve.cjs)
#      API  http://192.168.2.8:8080   번들이 호출하는 주소 (아래 EXPO_PUBLIC_API_URL)
#    화면 8081 → API 8080 은 교차 출처라 API CORS 허용 목록이 필요합니다.
#
#    ⚠ 192.168.2.8 은 사내망 주소입니다. VPN 이 꺼져 있으면 아무 요청도 닿지 않습니다.
#    이 파일에 서버 주소를 적어 두는 대신, 아래 값은 '기본값'으로만 남겨 두십시오.
#    실서버 주소가 여기 남아 있으면 `npm run check:env` 가 실패시킵니다.
# ─────────────────────────────────────────────────────────────

# API 서버 주소 (Base URL). 뒤에 /api/v1 이 붙습니다.
#  · 이 값은 npm run web:* 가 실행할 때마다 대상에 맞게 덮어씁니다.
#  · 직접 expo 를 띄울 때(드물게)만 여기를 고치면 됩니다.
EXPO_PUBLIC_API_URL=http://localhost:8080

# 목(mock) 응답 사용 여부.
#  false — EXPO_PUBLIC_API_URL 의 실 서버로 HTTP 요청을 보냅니다 (기본값)
#  true  — 백엔드 없이 명세 기반 목 데이터로 화면을 구동합니다
#          (API 서버를 띄울 수 없을 때만. 이때 EXPO_PUBLIC_LIVE_AUTH=false 도 함께 두세요)
EXPO_PUBLIC_USE_MOCK=false

# 목 응답 지연 (ms). 로딩 스피너 동작 확인용.
EXPO_PUBLIC_MOCK_DELAY=180

# 인증 API(로그인·회원가입·비밀번호 찾기)를 실 서버로 보낼지 여부.
#  true  — 목 모드에서도 /api/v1/auth/** 만 실 서버로 호출합니다 (기본값, 백엔드 구현 완료분)
#  false — 인증까지 전부 목으로 처리하고 기본 계정으로 자동 로그인합니다 (데모 모드)
EXPO_PUBLIC_LIVE_AUTH=true

# 요청 제한 시간 (ms). 대용량 집계 조회가 있어 기본 45초입니다.
EXPO_PUBLIC_API_TIMEOUT=45000

# 로그인 화면을 건너뛰고 기본 계정으로 자동 로그인 (목 인증 + 데모.autologin 일 때만).
EXPO_PUBLIC_DEMO_AUTOLOGIN=true

# ─────────────────────────────────────────────────────────────
# 사내 LLM 채팅 (/api/ai/chat · /api/ai/health) — **API 서버(../API)의 환경변수입니다**
#  · 화면은 LLM 서버를 직접 부르지 않고 EXPO_PUBLIC_API_URL 의 /api/ai/chat 만 부릅니다.
#    (LLM 서버 CORS 는 localhost 만 허용 · http 라 https 화면에서 mixed content · 인증 없는 주소 노출 금지)
#  · 그래서 아래 값에 EXPO_PUBLIC_ 접두사를 붙이지 않습니다 — 붙이면 번들에 주소가 들어갑니다.
#  · API 쪽 설정 위치: ../API/config/api.env(.local) — 생략하면 아래 기본값으로 동작합니다.
# ─────────────────────────────────────────────────────────────
# DWJE_LLM_BASE_URL=http://wddg.ddns.net:11435   # 사내 LAN: http://192.168.219.52:11435
# DWJE_LLM_MODEL=dwje-ax
# DWJE_LLM_TIMEOUT_MS=120000
# DWJE_LLM_API_KEY=                               # LLM 서버 토큰 인증(선택)

# 로컬 웹 개발에서만 loopback gateway proxy를 시험할 때 사용합니다.
# proxy는 DWJE_GATEWAY_API_KEY를 비공개 프로세스 환경변수로 읽습니다. EXPO_PUBLIC_ 접두사로 두지 마세요.
# npm run web (local) 가 이 값을 자동으로 물립니다. 직접 expo 를 띄울 때만 아래를 해제하세요.
# 배포·실서버 대상(server · nginx)에서는 비워 두고 운영 API의 /api/ai/chat 경로를 씁니다.
# EXPO_PUBLIC_LLM_API_URL=http://localhost:8787
# EXPO_PUBLIC_LLM_MODEL=dwje-ax
